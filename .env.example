# All optional. Without SNAPSHOT_BUCKET snapshots go to ./data/price-snapshots/.
#
# S3 backend:
#   SNAPSHOT_BUCKET=your-bucket-name
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_REGION=eu-central-1
#
# Telegram failure notifications (silent if unset):
#   TELEGRAM_BOT_TOKEN=...
#   TELEGRAM_CHAT_ID=...
#   COLLECT_NOTIFY=off
